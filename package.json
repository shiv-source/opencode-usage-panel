{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-usage-panel",
  "version": "2.0.0",
  "description": "Sidebar token-usage and cost panel for the opencode TUI. Breaks a session down by model with per-model cost, context usage, and configurable peak/off-peak pricing.",
  "author": { "name": "shiv kumar" },
  "contributors": [{ "name": "Andrea Casini" }],
  "repository": { "type": "git", "url": "git+https://github.com/shiv-source/opencode-usage-panel.git" },
  "homepage": "https://github.com/shiv-source/opencode-usage-panel",
  "bugs": { "url": "https://github.com/shiv-source/opencode-usage-panel/issues" },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": ["src", "README.md", "LICENSE"],
  "keywords": ["opencode", "opencode-plugin", "opencode-tui", "tokens", "usage", "cost", "tui"],
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.0",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "opencode": ">=2.3.0"
  }
}
