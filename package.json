{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-usage-plugin",
  "version": "0.1.0",
  "description": "Sidebar token-usage and cost panel for the opencode TUI. Breaks a session down by model with per-model cost, context usage, and configurable peak/off-peak pricing.",
  "author": "shiv kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiv-source/opencode-usage-plugin"
  },
  "homepage": "https://github.com/shiv-source/opencode-usage-plugin",
  "bugs": {
    "url": "https://github.com/shiv-source/opencode-usage-plugin/issues"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./tui": "./src/index.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tokens",
    "usage",
    "cost"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "opencode": ">=1.18.0"
  }
}
